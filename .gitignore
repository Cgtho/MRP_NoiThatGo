# ==========================================
# 1. DOCKER - LOCAL DEVELOPMENT
# ==========================================
# Docker chỉ dùng cho môi trường local cá nhân.
# Thành viên khác trong team sử dụng XAMPP.

Dockerfile
docker-compose*.yml
.dockerignore
.env.docker


# ==========================================
# 2. NODE.JS / JAVASCRIPT
# ==========================================

# Dependencies
node_modules/
jspm_packages/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Cache
.npm/
.eslintcache
.cache/
.parcel-cache/
.vite/

# Build outputs
dist/
build/
.next/
.nuxt/

# Package artifacts
*.tgz
.yarn-integrity


# ==========================================
# 3. PHP / COMPOSER
# ==========================================

# Composer dependencies
/vendor/

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# PHP tools cache
.php-cs-fixer.cache
.phpstan.cache


# ==========================================
# 4. CONFIG FOLDER (Bỏ qua cấu hình cá nhân)
# ==========================================
# Ignore toàn bộ các file bên trong thư mục config/
config/*

# Ngoại trừ các file mẫu để team clone về biết cách cấu hình (nếu có)
!config/config.example.php
# Hoặc nếu bạn muốn giữ lại file .gitkeep để Git đồng bộ được thư mục trống:
#!config/.gitkeep


# ==========================================
# 5. IDE / EDITOR
# ==========================================

# Visual Studio Code
.vscode/

# JetBrains IDEs
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace


# ==========================================
# 6. ENVIRONMENT VARIABLES / SECRETS
# ==========================================

# Environment files
.env
.env.local
.env.*.local

# Keep example environment files
!.env.example
!.env.example.local


